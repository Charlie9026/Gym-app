{
  "name": "gym-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-sw.mjs",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sync": "firebase emulators:exec --only auth,firestore --project demo-gym-log 'playwright test -c playwright.sync.config.ts'"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.37.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
