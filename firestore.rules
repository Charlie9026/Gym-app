rules_version = '2';

// Overload (first called Gym Log).
// - users/{uid}/records: your own workouts and settings. Only you can read or
//   write them; nobody signed out can.
// - leaderboard/{uid}: your public leaderboard entry (nickname, points, rank,
//   strength scores) if you join the leaderboards. Anyone signed in can read
//   entries; only you can write yours, within limits checked here.
// - friendCodes/{code}: which account a friend code belongs to.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/records/{record} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.updatedAt is number
        && (request.resource.data.json == null
            || (request.resource.data.json is string && request.resource.data.json.size() < 900000));
    }

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validEntry(request.resource.data);
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      // Claim a free code for yourself; codes can't be taken over or changed.
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Limits match src/leaderboard.ts: at most 195 points a week (7 full days,
    // goal and full streak bonus), and strength scores of at most 300 (three
    // times the intermediate standard for a lift).
    function validEntry(d) {
      return d.keys().hasOnly(['name', 'code', 'weekId', 'points', 'last4', 'streak', 'tier', 'strength', 'lifts', 'updatedAt'])
        && d.keys().hasAll(['name', 'code', 'weekId', 'points', 'last4', 'streak', 'tier', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.code is string && d.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && d.weekId is string && d.weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && d.points is int && d.points >= 0 && d.points <= 195
        && d.last4 is int && d.last4 >= 0 && d.last4 <= 780
        && d.streak is int && d.streak >= 0 && d.streak <= 520
        && d.tier in ['bronze', 'silver', 'gold', 'platinum', 'diamond']
        && (!('strength' in d) || d.strength == null || (d.strength is int && d.strength >= 0 && d.strength <= 300))
        && (!('lifts' in d) || d.lifts == null || validLifts(d.lifts))
        && d.updatedAt == request.time;
    }

    // Your best (up to) 3 lifts: l1, l2, l3, each an exercise id and its score.
    function validLifts(l) {
      return l is map && l.keys().hasOnly(['l1', 'l2', 'l3'])
        && (!('l1' in l) || validLift(l.l1))
        && (!('l2' in l) || validLift(l.l2))
        && (!('l3' in l) || validLift(l.l3));
    }

    function validLift(x) {
      return x is map && x.keys().hasOnly(['id', 'score'])
        && x.id is string && x.id.matches('^preset-[a-z0-9-]{1,40}$')
        && x.score is int && x.score >= 0 && x.score <= 300;
    }
  }
}
