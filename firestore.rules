rules_version = '2';

// Gym Log: each signed-in person can read and write only their own records,
// stored at users/{their uid}/records/{record}. Nobody else (and nobody signed
// out) can read or change them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/records/{record} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.updatedAt is number
        && (request.resource.data.json == null
            || (request.resource.data.json is string && request.resource.data.json.size() < 900000));
    }
  }
}
